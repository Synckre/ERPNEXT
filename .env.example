# Modelo por defecto (provider:model)
DEEP_AGENT_MODEL=deepseek:deepseek-v4-flash

# Requerido por DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Configuración de ERPNext
ERPNEXT_URL=https://tu-instancia.erpnext.com
ERPNEXT_API_KEY=tu_api_key
ERPNEXT_API_SECRET=tu_api_secret

# Configuración de Seguridad y CORS (Dominio permitido)
# Permite restringir peticiones HTTP a dominios específicos separados por coma
ALLOWED_ORIGINS=https://tu-app-web.com,https://openwebui.tu-dominio.com

# Clave de autenticación para proteger los endpoints de este agente (Bearer Token / X-API-Key)
AGENT_API_KEY=sk-tu-clave-secreta-del-agente

# Desactivar interrupciones nativas de LangGraph para compatibilidad con Open WebUI / Cursor (default: false)
# Déjalo en false para que las herramientas se ejecuten fluidamente en chats como Open WebUI.
ENABLE_INTERRUPTS=false

# Opcional: URL base alternativa (default: https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=

# Opcional pero recomendado para tracing con LangSmith
# LANGSMITH_API_KEY=lsv2_...
